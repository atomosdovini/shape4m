<% if resource.errors.any? %>
  <div class="rounded-xl border border-red-400/20 bg-red-500/10 px-3 py-2 mb-4">
    <h3 class="text-sm font-semibold text-red-200 mb-2">
      <%= pluralize(resource.errors.count, "erro") %> encontrado(s):
    </h3>
    <ul class="text-sm text-red-200 list-disc pl-5 space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
