<div class="space-y-4">
  <h2 class="text-2xl font-semibold mb-6">Criar Conta</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "block text-sm text-zinc-300 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2 text-sm focus:outline-none focus:border-white/20" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm text-zinc-300 mb-1" %>
      <% if @minimum_password_length %>
        <em class="text-xs text-zinc-400">(<%= @minimum_password_length %> caracteres mínimo)</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2 text-sm focus:outline-none focus:border-white/20" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar Senha", class: "block text-sm text-zinc-300 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2 text-sm focus:outline-none focus:border-white/20" %>
    </div>

    <div>
      <%= f.submit "Criar Conta", class: "w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-3" %>
    </div>
  <% end %>

  <div class="text-center text-sm text-zinc-400">
    <%= render "devise/shared/links" %>
  </div>
</div>
