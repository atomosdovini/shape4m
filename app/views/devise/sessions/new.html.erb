<div class="space-y-4">
  <h2 class="text-2xl font-semibold mb-6">Entrar</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block text-sm text-zinc-300 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2 text-sm focus:outline-none focus:border-white/20" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm text-zinc-300 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2 text-sm focus:outline-none focus:border-white/20" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center">
        <%= f.check_box :remember_me, class: "rounded border-white/10 bg-zinc-950/40" %>
        <%= f.label :remember_me, "Lembrar-me", class: "ml-2 text-sm text-zinc-300" %>
      </div>
    <% end %>

    <div>
      <%= f.submit "Entrar", class: "w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-3" %>
    </div>
  <% end %>

  <div class="text-center text-sm text-zinc-400">
    <%= render "devise/shared/links" %>
  </div>
</div>
