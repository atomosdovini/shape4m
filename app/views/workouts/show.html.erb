<div class="space-y-4">
  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-sm text-zinc-300">Treinos da semana</p>
        <p class="text-lg font-semibold"><%= @date.strftime("%d/%m/%Y") %></p>
      </div>

<div class="flex items-center gap-2">
  <%= link_to "←", workout_on_path(@prev_week_date.to_s),
        class: "inline-flex items-center justify-center rounded-lg bg-white/10 px-2 py-1 text-sm leading-none text-zinc-200" %>

  <%= link_to "→", workout_on_path(@next_week_date.to_s),
        class: "inline-flex items-center justify-center rounded-lg bg-white/10 px-2 py-1 text-sm leading-none text-zinc-200" %>
</div>

    </div>

<div class="mt-4">
  <% labels = %w[Seg Ter Qua Qui Sex] %>

  <div class="flex gap-2 overflow-x-auto pb-1 [-webkit-overflow-scrolling:touch]">
    <% @week_days.each_with_index do |d, idx| %>
      <% active = (d == @date) %>
      <%= link_to workout_on_path(d.to_s),
            class: "shrink-0 rounded-full border px-4 py-2 text-xs font-semibold #{active ? 'bg-white text-zinc-950 border-white' : 'bg-white/5 text-zinc-200 border-white/10'}" do %>
        <%= labels[idx] %>
      <% end %>
    <% end %>
  </div>
</div>


    <div class="mt-4 flex gap-2">
      <%= link_to "Hoje", workout_path,
            class: "rounded-xl bg-white text-zinc-950 font-medium px-3 py-2 text-sm" %>
      <%= link_to "Check-in (Hoje)", today_path,
            class: "rounded-xl bg-white/10 text-white px-3 py-2 text-sm" %>
    </div>
  </div>

  <!-- Treino selecionado -->
  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300">Treino selecionado</p>

    <% if @workout_name.present? %>
      <p class="text-lg font-semibold"><%= @workout_name %></p>
      <p class="text-xs text-zinc-400 mt-1">Descanso: 60–120s • termine com 1–3 reps na reserva.</p>

      <div class="mt-4 space-y-2">
        <% @workout.each_with_index do |(name, sets), idx| %>
          <div class="rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium"><%= idx + 1 %>. <%= name %></span>
              <span class="text-xs text-zinc-300"><%= sets %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-lg font-semibold">Sem treino (descanso)</p>
      <p class="text-sm text-zinc-400 mt-2">Foca em passos + dieta.</p>
    <% end %>
  </div>

  <!-- Observação fixa -->
  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300">Progressão</p>
    <ul class="mt-2 text-sm text-zinc-300 list-disc pl-5 space-y-1">
      <li>Se bater o topo das reps em todas as séries → aumente dificuldade.</li>
      <li>Opções: variação mais difícil, mais reps, mais tempo, mochila com peso.</li>
      <li>Consistência &gt; perfeição.</li>
    </ul>
  </div>
</div>
