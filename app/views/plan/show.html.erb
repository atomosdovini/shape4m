<div class="space-y-4">
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-xl font-semibold">Plano</h2>
    <%= link_to "Editar", edit_plan_configuration_path, class: "rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2" %>
  </div>
  
  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300"><%= @title %></p>
    <p class="text-lg font-semibold mt-1">Metas diárias</p>

    <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
      <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
        <p class="text-zinc-400 text-xs">Calorias</p>
        <p class="font-semibold"><%= @targets[:calories] %> kcal</p>
      </div>
      <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
        <p class="text-zinc-400 text-xs">Passos</p>
        <p class="font-semibold"><%= @targets[:steps] %></p>
      </div>
      <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
        <p class="text-zinc-400 text-xs">Macros</p>
        <p class="font-semibold"><%= @targets[:protein_g] %>P • <%= @targets[:fat_g] %>G • <%= @targets[:carbs_g] %>C</p>
      </div>
      <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
        <p class="text-zinc-400 text-xs">Água / Sono</p>
        <p class="font-semibold"><%= @targets[:water_l] %>L • <%= @targets[:sleep_h] %>h</p>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300">Meta do projeto</p>
    <p class="text-lg font-semibold">Peso alvo: <%= @goals[:weight_target] %></p>
    <p class="text-sm text-zinc-400 mt-1">Perda esperada: <%= @goals[:loss_12w] %> (12s) • <%= @goals[:loss_16w] %> (16s)</p>
  </div>

  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300 mb-3">Estrutura de refeições</p>
    <div class="space-y-4">
      <% @meals.each_with_index do |meal, meal_index| %>
        <%= render partial: "plan/meal_options", locals: { meal: meal, meal_index: meal_index } %>
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300">Lista de alimentos</p>
    <div class="mt-3 grid grid-cols-1 gap-3">
      <% @foods.each do |k, items| %>
        <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
          <p class="font-semibold capitalize"><%= k.to_s.gsub("_", " ") %></p>
          <p class="text-sm text-zinc-300 mt-2"><%= items.join(" • ") %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300">Regras do jogo</p>
    <ul class="mt-3 space-y-2">
      <% @rules.each do |r| %>
        <li class="rounded-xl border border-white/10 bg-zinc-950/40 px-3 py-2 text-sm text-zinc-200">✅ <%= r %></li>
      <% end %>
    </ul>
  </div>
</div>

<style>
  /* Wrapper das tabs com wrap */
  .meal-tabs-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    margin-top: 15px;
    margin-bottom: 15px;
  }
  
  /* Estilos das tabs */
  .meal-option-tab {
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 0.5rem;
    border: 1px solid;
    transition: all 0.2s;
    white-space: nowrap;
    background: rgba(24, 24, 27, 0.4);
    border-color: rgba(255, 255, 255, 0.1);
    color: rgb(161, 161, 170);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
  }
  
  .meal-option-tab:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }
  
  .meal-option-tab.active {
    background: rgba(5, 150, 105, 0.2);
    border-color: rgba(16, 185, 129, 0.5);
    color: rgb(110, 231, 183);
  }
  
  /* Conteúdo das opções */
  .meal-option-content {
    display: none;
  }
  
  .meal-option-content.active {
    display: block;
  }
</style>

<script>
  // Função global para trocar de tab (chamada pelo onclick)
  function switchMealTab(mealIndex, optionIndex) {
    // Remove active de todas as tabs desta refeição
    const allTabs = document.querySelectorAll('[id^="meal-tab-' + mealIndex + '-"]');
    allTabs.forEach(tab => {
      tab.classList.remove('active');
    });
    
    // Remove active de todos os conteúdos desta refeição
    const allContents = document.querySelectorAll('[id^="meal-content-' + mealIndex + '-"]');
    allContents.forEach(content => {
      content.classList.remove('active');
    });
    
    // Adiciona active à tab clicada
    const selectedTab = document.getElementById('meal-tab-' + mealIndex + '-' + optionIndex);
    if (selectedTab) {
      selectedTab.classList.add('active');
    }
    
    // Adiciona active ao conteúdo correspondente
    const selectedContent = document.getElementById('meal-content-' + mealIndex + '-' + optionIndex);
    if (selectedContent) {
      selectedContent.classList.add('active');
    }
  }
</script>
