<% if @log.nil? %>
  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-lg font-semibold">Sem dados</p>
    <p class="text-sm text-zinc-400 mt-1">Não existe check-in para <%= @date.strftime("%d/%m/%Y") %>.</p>
    <div class="mt-4">
      <%= link_to "Voltar", root_path, class: "block rounded-xl bg-white/10 text-white px-3 py-3 text-center" %>
    </div>
  </div>
<% else %>
  <div class="space-y-4">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
      <p class="text-sm text-zinc-300">Dia</p>
      <p class="text-lg font-semibold"><%= @date.strftime("%d/%m/%Y") %></p>

      <div class="mt-3 grid grid-cols-2 gap-2 text-sm text-zinc-300">
        <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
          <p class="text-xs text-zinc-400">Peso</p>
          <p class="font-semibold"><%= @log.weight_kg.present? ? "#{@log.weight_kg} kg" : "—" %></p>
        </div>
        <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
          <p class="text-xs text-zinc-400">Cintura</p>
          <p class="font-semibold"><%= @log.waist_cm.present? ? "#{@log.waist_cm} cm" : "—" %></p>
        </div>
      </div>

      <div class="mt-3">
        <p class="text-sm text-zinc-300">Checklist</p>
        <p class="text-xs text-zinc-400">Score: <span class="text-white font-semibold"><%= @log.completed_score %>/6</span></p>

        <div class="mt-2 space-y-2 text-sm">
          <% items = [
            [@log.hit_protein,  "Bati proteína (140g)"],
            [@log.hit_calories, "Fiquei em ~1600 kcal"],
            [@log.hit_steps,    "Fiz 12.000 passos"],
            [@log.did_workout,  "Fiz o treino de força"],
            [@log.hit_water,    "Bebi 2,5–3L água"],
            [@log.hit_sleep,    "Dormi 7h+"]
          ] %>

          <% items.each do |ok, label| %>
            <div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-3 py-2">
              <span><%= label %></span>
              <span class="<%= ok ? 'text-emerald-300' : 'text-zinc-500' %>"><%= ok ? "✅" : "—" %></span>
            </div>
          <% end %>
        </div>
      </div>

      <% if @log.notes.present? %>
        <div class="mt-3">
          <p class="text-xs text-zinc-400">Notas</p>
          <p class="text-sm text-zinc-200 mt-1"><%= @log.notes %></p>
        </div>
      <% end %>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
      <p class="text-sm text-zinc-300">Treino do dia</p>
      <% if @workout_name.present? %>
        <p class="text-lg font-semibold"><%= @workout_name %></p>
        <div class="mt-3 divide-y divide-white/10">
          <% @workout.each do |name, sets| %>
            <div class="py-2 flex items-center justify-between gap-3">
              <span class="text-sm"><%= name %></span>
              <span class="text-xs text-zinc-300"><%= sets %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-lg font-semibold">Descanso / Passos</p>
        <p class="text-sm text-zinc-400 mt-1">Sábado: caminhada longa • Domingo: descanso + passos leves.</p>
      <% end %>
    </div>

    <div class="grid grid-cols-2 gap-2">
      <%= link_to "Voltar", root_path, class: "rounded-xl bg-white/10 text-white px-3 py-3 text-center" %>
      <%= link_to "Hoje", today_path, class: "rounded-xl bg-white text-zinc-950 font-semibold px-3 py-3 text-center" %>
    </div>
  </div>
<% end %>
