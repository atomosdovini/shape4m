<div class="space-y-4">
  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
    <p class="text-sm text-zinc-300">Histórico</p>
    <p class="text-lg font-semibold">Últimos dias</p>
  </div>

  <div class="space-y-2">
    <% @logs.each do |log| %>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
        <div class="flex items-center justify-between">
          <p class="font-semibold"><%= log.date.strftime("%d/%m/%Y") %></p>
          <span class="text-xs rounded-full px-2 py-1 border border-white/10 bg-zinc-950/40">
            <%= log.completed_score %>/6
          </span>
        </div>

        <div class="mt-2 grid grid-cols-2 gap-2 text-sm text-zinc-300">
          <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
            <p class="text-xs text-zinc-400">Peso</p>
            <p class="font-semibold"><%= log.weight_kg.present? ? "#{log.weight_kg} kg" : "—" %></p>
          </div>
          <div class="rounded-xl border border-white/10 bg-zinc-950/40 p-3">
            <p class="text-xs text-zinc-400">Cintura</p>
            <p class="font-semibold"><%= log.waist_cm.present? ? "#{log.waist_cm} cm" : "—" %></p>
          </div>
        </div>

        <% if log.notes.present? %>
          <p class="mt-3 text-sm text-zinc-300"><span class="text-zinc-400">Notas:</span> <%= log.notes %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
